<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Operações - Planning Poker</title>
  
  <!-- Scripts Compatíveis do Firebase -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

  <style>
    :root {
      --bg-main: #0a0f1e;
      --bg-card: #131b2e;
      --bg-card-hover: #1c2744;
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --border: #23314f;
      --success: #34d399;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: var(--bg-main); color: var(--text); display: flex; height: 100vh; overflow: hidden; }

    aside { width: 340px; background: var(--bg-card); border-right: 1px solid var(--border); display: flex; flex-direction: column; }
    .sidebar-header { padding: 20px; border-bottom: 1px solid var(--border); }
    .sidebar-header h2 { font-size: 1.1rem; color: var(--accent); }
    .story-input-container { padding: 15px 20px; border-bottom: 1px solid var(--border); }
    textarea { width: 100%; height: 75px; background: var(--bg-main); border: 1px solid var(--border); border-radius: 6px; color: var(--text); padding: 8px; resize: none; font-size: 0.85rem; outline: none; }
    textarea:focus { border-color: var(--accent); }

    .btn { cursor: pointer; background: linear-gradient(135deg, var(--accent-hover), var(--accent)); color: #0a0f1e; border: none; padding: 8px 14px; font-weight: 600; border-radius: 6px; transition: 0.2s; }
    .btn:hover { opacity: 0.9; }
    .btn-secondary { background: transparent; color: var(--text-muted); border: 1px solid var(--border); }
    .btn-secondary:hover { color: var(--text); background: var(--border); }

    .story-list { flex: 1; overflow-y: auto; padding: 15px 20px; list-style: none; }
    .story-item { background: var(--bg-main); padding: 10px 12px; border-radius: 6px; border: 1px solid var(--border); margin-bottom: 8px; cursor: pointer; }
    .story-item.active { border-color: var(--accent); background: #152238; }

    main { flex: 1; display: flex; flex-direction: column; padding: 25px 35px; overflow-y: auto; }
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid var(--border); }
    .user-profile { display: flex; align-items: center; gap: 10px; }
    select, input[type="text"] { background: var(--bg-card); border: 1px solid var(--border); color: var(--text); padding: 8px 12px; border-radius: 6px; outline: none; }

    .poker-table-container { display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at center, #1b2845 0%, #0d1527 100%); border: 2px solid var(--border); border-radius: 20px; padding: 30px; min-height: 260px; margin-bottom: 25px; }
    .current-topic { text-align: center; margin-bottom: 20px; }
    .players-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin-bottom: 20px; }
    .player-card { display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .player-card .card-box { width: 55px; height: 80px; background: var(--bg-card); border: 2px dashed var(--border); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem; }
    .player-card.has-voted .card-box { border-style: solid; border-color: var(--accent); background: #173254; color: transparent; }
    .player-card.revealed .card-box { background: var(--accent); color: #0a0f1e; border-style: solid; }
    .table-actions { display: flex; gap: 12px; }

    .metrics-bar { display: flex; gap: 20px; background: var(--bg-card); border: 1px solid var(--border); padding: 15px 25px; border-radius: 10px; margin-bottom: 25px; justify-content: space-around; }
    .metric-item { text-align: center; }
    .metric-item span { display: block; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; }
    .metric-item strong { font-size: 1.3rem; color: var(--accent); }

    .deck-container { margin-top: auto; }
    .cards-row { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; }
    .deck-card { min-width: 55px; height: 85px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; font-size: 1.2rem; font-weight: bold; transition: 0.2s; }
    .deck-card:hover { border-color: var(--accent); transform: translateY(-4px); }
    .deck-card.selected { background: linear-gradient(135deg, var(--accent-hover), var(--accent)); color: #0a0f1e; }
    .deck-card span { font-size: 0.65rem; font-weight: normal; margin-top: 4px; }
  </style>
</head>
<body>

  <aside>
    <div class="sidebar-header">
      <h2>Histórias da Sprint</h2>
    </div>
    <div class="story-input-container">
      <textarea id="storyInput" placeholder="Cole as tarefas aqui (uma por linha)&#10;Ex: DMND0001467 - STRY0039295 Exame Teórico"></textarea>
      <button class="btn" style="width: 100%; margin-top: 8px;" onclick="addStories()">Carregar Histórias</button>
    </div>
    <ul class="story-list" id="storyList"></ul>
  </aside>

  <main>
    <header>
      <div>
        <h1 id="roomTitle">Sprint 14 — Portal Operações</h1>
        <p style="font-size: 0.8rem; color: var(--text-muted);">Conversão: <strong>1 Ponto = 2 Horas</strong></p>
      </div>
      <div class="user-profile">
        <input type="text" id="userName" placeholder="O seu nome" onchange="updateUser()">
        <select id="userRole" onchange="updateUser()">
          <option value="dev">Dev (Vota)</option>
          <option value="facilitator">Facilitador / GP</option>
          <option value="observer">Observador</option>
        </select>
      </div>
    </header>

    <div class="poker-table-container">
      <div class="current-topic">
        <span style="font-size: 0.75rem; color: var(--accent); text-transform: uppercase;">A Estimar Agora:</span>
        <h3 id="activeStoryTitle">A aguardar seleção...</h3>
      </div>
      <div class="players-grid" id="playersGrid"></div>
      <div class="table-actions">
        <button class="btn" onclick="toggleReveal()" id="btnReveal">Revelar Cartas</button>
        <button class="btn btn-secondary" onclick="resetRound()">Reiniciar Ronda</button>
      </div>
    </div>

    <div class="metrics-bar">
      <div class="metric-item"><span>Votos</span><strong id="statVoted">0/0</strong></div>
      <div class="metric-item"><span>Média</span><strong id="statAvg">-</strong></div>
      <div class="metric-item"><span>Consenso</span><strong id="statConsensus">-</strong></div>
      <div class="metric-item"><span>Horas (&times;2)</span><strong id="statHours" style="color: var(--success);">-</strong></div>
    </div>

    <div class="deck-container" id="deckSection">
      <h4 style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">Escolha a sua carta (Modified Fibonacci):</h4>
      <div class="cards-row" id="cardsDeck"></div>
    </div>
  </main>

  <script>
    // Configuração oficial do Firebase integrada
    const firebaseConfig = {
      apiKey: "AIzaSyAsBY2yYno5HMaFkmiDAZfKCTtLjZYikPA",
      authDomain: "planningpoker-e2caa.firebaseapp.com",
      databaseURL: "https://planningpoker-e2caa-default-rtdb.firebaseio.com",
      projectId: "planningpoker-e2caa",
      storageBucket: "planningpoker-e2caa.firebasestorage.app",
      messagingSenderId: "153909141932",
      appId: "1:153909141932:web:f6b042db4bbd48c9cf1a09",
      measurementId: "G-YWFE7JBCZB"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();
    const roomRef = db.ref('rooms/sprint14');

    const CARDS = ['0', '½', '1', '2', '3', '5', '8', '13', '20', '40', '100', '?', '☕'];
    
    let myId = localStorage.getItem('poker_uid') || 'dev_' + Math.floor(Math.random() * 10000);
    localStorage.setItem('poker_uid', myId);

    let myName = localStorage.getItem('poker_name') || 'Membro ' + myId.slice(-2);
    let myRole = localStorage.getItem('poker_role') || 'dev';
    let myVote = null;

    document.getElementById('userName').value = myName;
    document.getElementById('userRole').value = myRole;

    let gameState = {
      activeStory: 'A aguardar seleção...',
      stories: [],
      revealed: false,
      players: {}
    };

    roomRef.on('value', (snapshot) => {
      const data = snapshot.val();
      if (data) {
        gameState.stories = data.stories ? Object.values(data.stories) : [];
        gameState.activeStory = data.activeStory || 'A aguardar seleção...';
        gameState.revealed = data.revealed || false;
        gameState.players = data.players || {};

        if (gameState.players[myId]) {
          myVote = gameState.players[myId].vote;
        }

        renderDeck();
        renderStories();
        renderTable();
      }
    });

    function updateUser() {
      myName = document.getElementById('userName').value || 'Anónimo';
      myRole = document.getElementById('userRole').value;
      localStorage.setItem('poker_name', myName);
      localStorage.setItem('poker_role', myRole);
      if (myRole !== 'dev') myVote = null;
      syncMyPlayer();
    }

    function syncMyPlayer() {
      roomRef.child('players/' + myId).set({
        id: myId,
        name: myName,
        role: myRole,
        vote: myVote
      });
    }

    function selectCard(card) {
      if (myRole !== 'dev') return;
      myVote = (myVote === card) ? null : card;
      syncMyPlayer();
    }

    function renderDeck() {
      const container = document.getElementById('cardsDeck');
      container.innerHTML = '';
      if (myRole !== 'dev') {
        document.getElementById('deckSection').style.display = 'none';
        return;
      }
      document.getElementById('deckSection').style.display = 'block';

      CARDS.forEach(card => {
        const div = document.createElement('div');
        div.className = `deck-card ${myVote === card ? 'selected' : ''}`;
        const num = card === '½' ? 0.5 : parseFloat(card);
        const hours = !isNaN(num) ? `<span>${num * 2}h</span>` : '';
        div.innerHTML = `${card}${hours}`;
        div.onclick = () => selectCard(card);
        container.appendChild(div);
      });
    }

    function renderTable() {
      const container = document.getElementById('playersGrid');
      container.innerHTML = '';

      const devs = Object.values(gameState.players).filter(p => p.role === 'dev');
      let votedCount = 0;
      let numericVotes = [];

      devs.forEach(player => {
        const hasVoted = player.vote !== null && player.vote !== undefined;
        if (hasVoted) votedCount++;

        const card = document.createElement('div');
        card.className = `player-card ${hasVoted ? 'has-voted' : ''} ${gameState.revealed ? 'revealed' : ''}`;

        let display = '';
        if (gameState.revealed) {
          display = player.vote || '-';
          const n = player.vote === '½' ? 0.5 : parseFloat(player.vote);
          if (!isNaN(n)) numericVotes.push(n);
        } else if (hasVoted) {
          display = '✓';
        }

        card.innerHTML = `<div class="card-box">${display}</div><span style="font-size:0.8rem;color:var(--text-muted);">${player.name}</span>`;
        container.appendChild(card);
      });

      document.getElementById('statVoted').innerText = `${votedCount}/${devs.length}`;

      if (gameState.revealed && numericVotes.length > 0) {
        const sum = numericVotes.reduce((a, b) => a + b, 0);
        const avg = (sum / numericVotes.length).toFixed(1);
        
        const counts = {};
        numericVotes.forEach(v => counts[v] = (counts[v] || 0) + 1);
        const consensus = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b);

        document.getElementById('statAvg').innerText = avg;
        document.getElementById('statConsensus').innerText = consensus + ' pts';
        document.getElementById('statHours').innerText = (parseFloat(consensus) * 2) + 'h';
      } else {
        document.getElementById('statAvg').innerText = '-';
        document.getElementById('statConsensus').innerText = '-';
        document.getElementById('statHours').innerText = '-';
      }

      document.getElementById('btnReveal').innerText = gameState.revealed ? 'Ocultar Cartas' : 'Revelar Cartas';
      document.getElementById('activeStoryTitle').innerText = gameState.activeStory;
    }

    function toggleReveal() {
      roomRef.child('revealed').set(!gameState.revealed);
    }

    function resetRound() {
      const updates = { revealed: false };
      Object.keys(gameState.players).forEach(id => {
        updates['players/' + id + '/vote'] = null;
      });
      roomRef.update(updates);
    }

    function addStories() {
      const text = document.getElementById('storyInput').value.trim();
      if (!text) return;
      text.split('\n').forEach(line => {
        const item = line.trim();
        if (item) roomRef.child('stories').push({ title: item });
      });
      document.getElementById('storyInput').value = '';
    }

    function renderStories() {
      const ul = document.getElementById('storyList');
      ul.innerHTML = '';
      gameState.stories.forEach(story => {
        const li = document.createElement('li');
        li.className = `story-item ${gameState.activeStory === story.title ? 'active' : ''}`;
        li.innerText = story.title;
        li.onclick = () => {
          roomRef.child('activeStory').set(story.title);
          resetRound();
        };
        ul.appendChild(li);
      });
    }

    syncMyPlayer();
  </script>
</body>
</html>
